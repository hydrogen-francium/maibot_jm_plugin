{
  "manifest_version": 2,
  "version": "2.0.0",
  "name": "JM 本子下载插件",
  "description": "基于 jmcomic 的 MaiBot 插件，支持 JM 下载、PDF/ZIP 生成与以图搜本",
  "author": {
    "name": "氢",
    "url": "https://github.com/hydrogen-francium"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/hydrogen-francium/maibot_jm_plugin",
    "homepage": "https://github.com/hydrogen-francium/maibot_jm_plugin",
    "documentation": "https://github.com/hydrogen-francium/maibot_jm_plugin#readme",
    "issues": "https://github.com/hydrogen-francium/maibot_jm_plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.12.14"
    },
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=11.3.0"
    },
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=2.7.4,<3"
    },
    {
      "type": "python_package",
      "name": "pyzipper",
      "version_spec": ">=0.3.6,<1"
    }
  ],
  "capabilities": [
    "send.text",
    "message.get_by_id",
    "api.call",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "hydrogen-francium.jm_plugin",
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.webp",
      "fallback": "image"
    }
  }
}
